# Outlook clone — local dev config.
#
# Copy to .env (already in .gitignore) and override as needed:
#
#   cp .env.example .env
#
# scripts/start.sh sources this file; docker compose also auto-loads
# .env from the current directory.

# ── Legacy localhost endpoint ────────────────────────────────────────────
# Host port for the FastAPI server. Hits http://localhost:${APP_PORT}.
# The container always serves on :8030 internally; this only changes the
# host-side mapping.
APP_PORT=8045

# Host port for postgres (use psql to talk to it directly).
DB_PORT=5445

# Host port for the Vite dev server (`task outlook:dev-frontend`).
VITE_PORT=3045

# ── Named HTTPS endpoint (Caddy reverse proxy) ───────────────────────────
# When the caddy service is up (default for `scripts/start.sh`), the app
# is ALSO reachable at https://${CLONE_DOMAIN}:${CADDY_HOST_PORT}.
#
# Use `scripts/start.sh --without-https` to skip Caddy entirely; in that
# case only the localhost endpoint above is exposed.
CLONE_DOMAIN=outlook.clone.test
# 443 = pretty URL with no port suffix (https://outlook.clone.test/).
# If another service is already on host 443, bump this to e.g. 8443.
CADDY_HOST_PORT=443

# ── Security ─────────────────────────────────────────────────────────────
# Shared secret required by POST /rl/reset (the RL state-reset endpoint).
# Tests/harness send X-Reset-Token: $RL_RESET_TOKEN. When unset, the
# endpoint rejects all callers with 403 (per §2 of the acceptance
# criteria — no public DB-wipe endpoint).
RL_RESET_TOKEN=dev-only-do-not-ship-to-prod
