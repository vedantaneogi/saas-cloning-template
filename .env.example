# =============================================================================
# saas-clone-factory — environment variables
# =============================================================================
#
# Copy this file to .env (gitignored) and fill in real values. The example
# file is checked in; the real file never is.

# -----------------------------------------------------------------------------
# Source-workspace credentials (Linear)
# -----------------------------------------------------------------------------
# Used by scripts/seed/linear-seed.mjs to seed your Linear workspace with
# realistic capture-source data. Get a personal API key at
# linear.app/<workspace>/settings/account/security → Personal API keys.
LINEAR_API_KEY=

# -----------------------------------------------------------------------------
# Clone API (apps/api)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/clone
# CORS_ORIGINS=["http://localhost:3000"]
# SEED_PATH=./seed.json
# API_LOG_SQL=false

# Auth — JWT signing secret for the lc_session cookie. Generate with
# `python -c "import secrets; print(secrets.token_urlsafe(48))"` for prod.
# AUTH_SECRET=dev-insecure-change-me
# AUTH_COOKIE_NAME=lc_session
# AUTH_SESSION_DAYS=30
# AUTH_COOKIE_SECURE=false   # set true behind HTTPS

# -----------------------------------------------------------------------------
# Clone web (apps/web)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
